# Copy to .env (never commit .env). docker compose reads it automatically.
MAVERICK_JWT_SECRET=change-me-to-at-least-32-random-characters
MAVERICK_ADMIN_EMAILS=admin@example.com
# Optional overrides
# NEO4J_PASSWORD=...
# MYSQL_PASSWORD=...
# GRAFANA_PASSWORD=...
# With the fine-tuned question model: docker compose --profile ai up -d
# AI_MODEL_URL=http://question-model:8080
# "Sign in with Google": OAuth client id (Google Cloud > APIs & Services > Credentials > Web application)
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Password reset emails over SMTP (e.g. Oracle Email Delivery: smtp.email.ca-toronto-1.oci.oraclecloud.com)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
# MAIL_FROM=Quiz King <no-reply@yourdomain>
