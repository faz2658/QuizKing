# Copy to .env (never commit .env). docker compose reads it automatically.
QUIZCADIA_JWT_SECRET=change-me-to-at-least-32-random-characters
QUIZCADIA_ADMIN_EMAILS=admin@example.com
# Optional overrides
# NEO4J_PASSWORD=...
# MYSQL_USER=quizcadia
# MYSQL_PASSWORD=...
# GRAFANA_PASSWORD=...
# With the fine-tuned question model: docker compose --profile ai up -d
# AI_MODEL_URL=http://question-model:8080
# "Sign in with Google": OAuth client id (Google Cloud > APIs & Services > Credentials > Web application)
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Google Analytics 4 measurement id; players are asked before it loads
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Analytics numbers on Admin > Website analytics: the property's number and a read-only service
# account key saved as secrets/ga-service-account.json (see deploy/README.md)
# GA_PROPERTY_ID=123456789
# GA_CREDENTIALS_FILE=/run/secrets/ga-service-account.json
# Password reset emails over SMTP (e.g. Oracle Email Delivery: smtp.email.ca-toronto-1.oci.oraclecloud.com)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
# MAIL_FROM=QuizCadia <no-reply@yourdomain>
