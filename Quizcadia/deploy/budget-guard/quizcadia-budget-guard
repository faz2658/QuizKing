#!/bin/bash
# Stops QuizCadia and powers this server off once the month's actual Oracle spend reaches the limit.
# Runs hourly from quizcadia-budget-guard.timer. Reads the budget with the server's own identity
# (instance principal: dynamic group quiz-king-server + policy quiz-king-budget-guard), no keys stored.
# Usage: quizcadia-budget-guard [--dry-run]
set -u
LIMIT="${LIMIT:-20}"
BUDGET="quiz-king-monthly-cap"
TENANCY="ocid1.tenancy.oc1..aaaaaaaadzqvbkinoflfl2oewgz5evkferxt57l6q7zsuhtl5ncuccnnvbkq"
INSTANCE="ocid1.instance.oc1.ca-toronto-1.an2g6ljrrdh7ijacm7mro2vupg6vbwp5nnxkzmjmmjg4gatcmxz6pejjqb7a"
OCI=/opt/oci-cli/bin/oci
export OCI_CLI_AUTH=instance_principal
log() { echo "$(date -u +%FT%TZ) $*" | tee -a /var/log/quizcadia-budget-guard.log; }

spent=$($OCI budgets budget budget list --compartment-id "$TENANCY" --target-type ALL \
  --query "data[?\"display-name\"==\`$BUDGET\`] | [0].\"actual-spend\"" --raw-output 2>/dev/null)
if [ $? -ne 0 ]; then log "could not read the budget (will try again next hour)"; exit 1; fi
case "$spent" in ""|null|None) spent=0 ;; esac

if awk -v s="$spent" -v l="$LIMIT" "BEGIN { exit !(s >= l) }"; then
  log "spend \$$spent reached the \$$LIMIT limit: stopping QuizCadia and this server"
  [ "${1:-}" = "--dry-run" ] && { log "dry run: nothing stopped"; exit 0; }
  cd /home/ubuntu/quizcadia && docker compose -f docker-compose.yml -f docker-compose.prod.yml stop
  $OCI compute instance action --instance-id "$INSTANCE" --action SOFTSTOP >/dev/null 2>&1 || shutdown -h now
else
  log "spend \$$spent is under the \$$LIMIT limit"
fi
